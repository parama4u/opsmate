# Server
PORT=5000
ENVIRONMENT=development
APP_API_KEY=orgchai-dev-key
APP_NAME=OrgChai
# Comma-separated browser origins. Use https://orgchai.com in production.
CORS_ORIGIN=http://localhost:3000

# Comma-separated admin emails (document ingest/delete + admin dashboard)
ADMIN_EMAILS=you@yourapp.com
ORGANIZATION_ID=default
ORG_ID_CLAIM=org_id
REQUIRE_ORG_CLAIM=false
CONNECTOR_ADMIN_EMAILS=
KNOWLEDGE_OWNER_EMAILS=
REVIEWER_EMAILS=
ANALYST_EMAILS=
AUDITOR_EMAILS=
SCIM_BEARER_TOKEN=

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://orgchai:orgchai@localhost:5432/orgchai
DIRECT_URL=postgresql://orgchai:orgchai@localhost:5432/orgchai

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SSO_PROVIDER_ID=
FIREBASE_SSO_PROVIDER_TYPE=oidc

# LLM (OpenAI-compatible API)
AIAND_API_KEY=
AIAND_BASE_URL=
MODEL_NAME=
MODEL_COST_PER_1K_TOKENS=0
PROMPT_VERSION=orgchai-v1
LOW_CONFIDENCE_REVIEW_SCORE=0.5
# Legacy alias for MODEL_NAME
MODAL_NAME=

# Slack (optional)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_CHANNELS=
SLACK_DIGESTS_ENABLED=false

# Documents directory (relative to api/)
DOCS_DIR=./data/documents
KNOWLEDGE_META_DIR=./data/knowledge
CONNECTORS_DIR=./data/connectors
ACTIONS_DIR=./data/actions
DISCOVERY_DIR=./data/discovery
EVALUATION_DIR=./data/evaluation
RECAPS_DIR=./data/recaps
DIRECTORY_DIR=./data/directory
METRICS_DIR=./data/metrics
BACKUP_DIR=./data/backups
BACKUP_RETENTION_COUNT=7
MIN_RETRIEVAL_SCORE=0.08
CHAT_RETENTION_DAYS=0
MODEL_DATA_RETENTION=provider-default
MODEL_NO_TRAINING=not-specified
DLP_ACTION=flag
ACTION_ALLOWLIST=draft_follow_up,draft_incident_summary,draft_onboarding_plan,draft_it_access_request,draft_policy_acknowledgement,draft_support_reply
DATA_RESIDENCY=not-specified
MODEL_REGION=provider-default
SECRETS_ROTATION_DAYS=90
DATA_AT_REST_ENCRYPTION=platform-managed
APPROVED_CONNECTOR_KINDS=local_folder,google_drive,sharepoint,rest_api
