# App (public, safe in browser)
NEXT_PUBLIC_APP_URL=https://orgchai.com
NEXT_PUBLIC_SITE_NAME=OrgChai.com

# Server-only: FastAPI URL (used by /api/proxy and server-side fetches)
API_BASE=http://localhost:5000

# Server-only: must match api APP_API_KEY. Injected by /api/proxy (never sent to browser).
APP_API_KEY=orgchai-dev-key

# Firebase (server-only, exposed to client via /api/firebase-config route)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin (token verification)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
